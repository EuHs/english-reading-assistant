# ---- English Reading Assistant server ----
PORT=8080
HOST=0.0.0.0
# The extension / userscripts send "Authorization: Bearer <API_TOKEN>". Generate one: openssl rand -hex 24
# (it can be viewed and regenerated later in the web app: 设置 → 扩展 / 油猴脚本连接)
API_TOKEN=change-me
# Web app admin account, written on first start only. Default admin / 123456, which must be changed at first login
# ADMIN_USER=admin
# ADMIN_PASSWORD=
DATA_DIR=./data

# Upstream AI (any OpenAI-compatible endpoint). Example: Z.AI coding plan
AI_BASE_URL=https://api.z.ai/api/coding/paas/v4
AI_API_KEY=
# Pick from GET /api/ai/models (pulled from the upstream server)
AI_MODEL=glm-4.6
# Request parameters; empty = not sent, so the model's default applies. The web app's 设置 page can change them.
AI_TEMPERATURE=0.2
AI_TOP_P=
AI_MAX_TOKENS=
# Thinking level: off / minimal / low / medium / high / xhigh / max (or a value the provider names), empty = default.
# AI_REASONING_FORMAT=auto writes it the way the provider expects (Z.AI GLM: thinking + reasoning_effort, OpenAI:
# reasoning_effort, Qwen: enable_thinking, OpenRouter: reasoning). "off" answers ~3x faster; a model that must think
# (e.g. GLM-5.3) gets its lowest level instead, adapted from the provider's error.
AI_REASONING=off
AI_REASONING_FORMAT=auto
# Extra JSON merged last into every chat request, for anything provider-specific
AI_EXTRA=
# Behind an HTTP proxy? Node only honours HTTPS_PROXY when this is set
# NODE_USE_ENV_PROXY=1

# Kokoro offline TTS (kokoro-js). Model (~90MB q8) downloads once into DATA_DIR/models
ENABLE_TTS=1
KOKORO_DTYPE=q8
TTS_VOICE=af_heart
# Mainland China servers: use a Hugging Face mirror for the one-time model download
HF_ENDPOINT=https://hf-mirror.com
TTS_PRELOAD=1
